---
import type { Project } from '../data/projects';
import MathText from './MathText.astro';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const Title = headingLevel === 2 ? 'h2' : 'h3';
const { title, tagline, summary, repoUrl, paperUrl, status, role, keywords } =
  project;
---

<li class="index-row">
  <div class="col-1">
    {status && (
      <span class="status status-note project-status">{status}</span>
    )}
  </div>

  <div class="col-2">
    <Title class="project-title"><MathText text={title} /></Title>

    {tagline && (
      <p class="project-tagline">
        <MathText text={tagline} />
      </p>
    )}
    <p class="project-summary"><MathText text={summary} /></p>

    {keywords.length > 0 && (
      <ul class="chip-row" aria-label="Keywords">
        {keywords.map((k) => (
          <li class="chip">
            <MathText text={k} />
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="project-links col-3">
    <a class="pub-link" href={repoUrl} target="_blank" rel="noopener noreferrer">
      GitHub
    </a>
    {paperUrl && (
      <a
        class="pub-link"
        href={paperUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Paper
      </a>
    )}
    <span class="project-role">{role}</span>
  </div>
</li>