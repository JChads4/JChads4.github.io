---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import MathText from './MathText.astro';

interface Props {
  item: CollectionEntry<'research'>;
  /** Heading level for the title. Pass 2 on pages with no intermediate h2. */
  headingLevel?: 2 | 3;
}

const { item, headingLevel = 3 } = Astro.props;
const Title = headingLevel === 2 ? 'h2' : 'h3';
const { title, status, since, keywords } = item.data;
const { Content } = await render(item);
---

<li class="index-row">
  {since && (
    <time class="research-since col-1" datetime={String(since)}>
      {since}
    </time>
  )}

  <div class="col-2">
    <Title class="research-title"><MathText text={title} /></Title>

    <div class="research-body">
      <Content />
    </div>

    {keywords.length > 0 && (
      <ul class="chip-row" aria-label="Keywords">
        {keywords.map((k) => (
          <li class="chip">
            <MathText text={k} />
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="research-meta col-3">
    {status && <span class={`status status-${status}`}>{status}</span>}
  </div>
</li>
