---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  item: CollectionEntry<'research'>;
  /** Heading level for the title. Pass 2 on pages with no intermediate h2. */
  headingLevel?: 2 | 3;
}

const { item, headingLevel = 3 } = Astro.props;
const Title = headingLevel === 2 ? 'h2' : 'h3';
const { title, status, since, keywords } = item.data;
const { Content } = await render(item);
---

<li class="research-item">
  <div class="research-head">
    <Title class="research-title">{title}</Title>
    <div class="research-meta">
      {status && <span class={`status status-${status}`}>{status}</span>}
      {since && <time>{since}</time>}
    </div>
  </div>

  <div class="research-body">
    <Content />
  </div>

  {keywords.length > 0 && (
    <ul class="chip-row" aria-label="Keywords">
      {keywords.map((k) => (
        <li class="chip">{k}</li>
      ))}
    </ul>
  )}
</li>
