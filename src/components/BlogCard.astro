---
import type { CollectionEntry } from 'astro:content';
import MathText from './MathText.astro';
import { formatPostDate, postHref } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Heading level for the title. Pass 2 on pages with no intermediate h2. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Title = headingLevel === 2 ? 'h2' : 'h3';
const { title, date, excerpt, image } = post.data;
---

<li class="post-item">
  {image && (
    <img
      class="post-thumb"
      src={image}
      alt=""
      width="740"
      height="416"
      loading="lazy"
      decoding="async"
    />
  )}

  <Title class="post-title">
    <a href={postHref(post)}><MathText text={title} /></a>
  </Title>

  <time class="news-date post-date" datetime={date}>
    {formatPostDate(date)}
  </time>

  {excerpt && (
    <p class="post-excerpt">
      <MathText text={excerpt} />
    </p>
  )}
</li>
