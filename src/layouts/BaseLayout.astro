---
import Masthead from '../components/Masthead.astro';
import Rail from '../components/Rail.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// KaTeX's own stylesheet, bundled by Vite so the maths fonts are self-hosted
// rather than fetched from a CDN at runtime. Its import order matters: it must
// come after global.css, or global's `code`/`pre`/`a` rules start winning ties
// against KaTeX's glyph rules.
import 'katex/dist/katex.min.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** The masthead's second line. Defaults to the research tagline; the blog
   *  routes pass `site.blogSubject` instead, since the two are different
   *  subjects. */
  subject?: string;
  /** Keep the page out of search indexes. For the tag pages, which carry one
   *  post each while the blog is small, and for the 404. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  subject,
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${site.title}`;

// Absolute URL for canonical + Open Graph (falls back to config if `site` unset).
const SITE_URL = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

// On the home page the masthead name is the page's own h1; everywhere else it
// is a link home and the page supplies its own h1.
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Libre Franklin, at 300/400/600/800. Nothing in the stylesheet asks for
         500 or 700, because those would be synthesised rather than loaded. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,300;0,400;0,600;0,800;1,400&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Masthead subject={subject} isHome={isHome} />

    <!-- Rail first in the DOM, so the keyboard order matches the visual order.
         The skip link above lets a keyboard user bypass the whole thing. -->
    <div class="container layout">
      <Rail />
      <main id="main" class="content">
        <slot />
      </main>
    </div>

    <Footer />
  </body>
</html>
