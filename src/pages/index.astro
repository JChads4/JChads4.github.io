---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexLabels from '../components/IndexLabels.astro';
import PostRow from '../components/PostRow.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import { visiblePosts } from '../lib/blog';
import { talks } from '../data/talks';
import { projects } from '../data/projects';

const posts = visiblePosts(await getCollection('blog'));

// Blog-first, but not unbounded: the front page shows the most recent handful
// and /blog/ holds the rest.
const RECENT = 10;
const recent = posts.slice(0, RECENT);
const hasMore = posts.length > recent.length;

// The record at a glance: each tile is a count and a door into its page.
const publications = await getCollection('publications');
const stats = [
  { value: posts.length, label: 'Posts', href: '/blog/' },
  { value: publications.length, label: 'Publications', href: '/publications/' },
  { value: talks.length, label: 'Talks', href: '/news/' },
  { value: projects.length, label: 'Projects', href: '/projects/' },
];
---

<BaseLayout subject={site.blogSubject} description={site.description}>
  <div class="container">
    <!-- The identity strip: one line naming who writes this and what it is
         about. Deliberately not a portrait and not a block of prose, both of
         which would push the index below the fold. -->
    <div class="identity">
      <!-- A nucleus with three orbits: the physics half of the site. Purely
           decorative, so hidden from assistive tech. -->
      <svg class="identity-emblem" viewBox="0 0 64 64" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="2.5">
          <ellipse cx="32" cy="32" rx="28" ry="10.5" />
          <ellipse cx="32" cy="32" rx="28" ry="10.5" transform="rotate(60 32 32)" />
          <ellipse cx="32" cy="32" rx="28" ry="10.5" transform="rotate(-60 32 32)" />
        </g>
        <circle cx="32" cy="32" r="6.5" fill="currentColor" />
        <circle cx="60" cy="32" r="3.5" fill="#fffdf7" stroke="currentColor" stroke-width="2" />
      </svg>
      <p class="identity-who">
        <strong>{site.role}</strong><br />
        {site.affiliation}{site.location ? ` · ${site.location}` : ''}
      </p>
      <p class="identity-what">{site.blogSubject}</p>
    </div>

    <ul class="stats" aria-label="At a glance">
      {
        stats.map((s) => (
          <li>
            <a class="stat" href={s.href}>
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      recent.length === 0 ? (
        <p class="empty-state">No posts yet.</p>
      ) : (
        <div class="index-block">
          <IndexLabels labels={['Date', 'Post', 'Topics']} />
          <ul class="index">
            {recent.map((post) => (
              <PostRow post={post} headingLevel={2} />
            ))}
          </ul>
        </div>
      )
    }

    <p class="post-back">
      <a href="/blog/">
        {hasMore ? `All ${posts.length} posts →` : 'Archive →'}
      </a>
    </p>
  </div>
</BaseLayout>
