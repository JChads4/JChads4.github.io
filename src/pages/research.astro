---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexLabels from '../components/IndexLabels.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { getCollection } from 'astro:content';

const researchItems = (await getCollection('research')).sort(
  (a, b) => (b.data.since ?? 0) - (a.data.since ?? 0)
);
---

<BaseLayout
  title="Research"
  description="Research areas and ongoing projects."
>
  <section class="page-head">
    <div class="container">
      <h1>Research</h1>
      <p>
        Current and recent research threads, and the questions driving them.
        Most threads lead into the publications listed on the{" "}
        <a href="/publications/">publications page</a>.
      </p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      {researchItems.length === 0 ? (
        <p class="empty-state">No research areas yet.</p>
      ) : (
        <div class="index-block index-block--research">
          <IndexLabels labels={['Since', 'Area', 'Status']} />
          <ul class="index">
            {researchItems.map((item) => (
              <ResearchCard item={item} headingLevel={2} />
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
