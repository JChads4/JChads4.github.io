---
import BaseLayout from '../layouts/BaseLayout.astro';
import MathText from '../components/MathText.astro';
import { cv } from '../data/cv';
import { site } from '../config';

const { summary, sections, skills } = cv;

// A section with no entries would otherwise render a heading with nothing under
// it, which is a visible wart at this row height. (`Service & peer review` is
// empty today.)
const filled = sections.filter((section) => section.entries.length > 0);
---

<BaseLayout
  title="Curriculum Vitae"
  description="Curriculum vitae and full academic record."
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-row">
        <h1>Curriculum Vitae</h1>
        <div class="print-actions no-print">
          {site.cvPdf && (
            <a class="btn btn-secondary" href={site.cvPdf}>Download PDF</a>
          )}
          <button
            type="button"
            class="btn btn-secondary"
            onclick="window.print()"
          >
            Print / Save as PDF
          </button>
        </div>
      </div>
      <p><MathText text={summary} /></p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      {filled.map((section) => (
        <div class="cv-section">
          <h2>{section.title}</h2>
          {/* The CV's own presentation rows are coarser than talks.ts, which
              holds one row per talk. Point across rather than duplicating. */}
          {section.title === 'Selected presentations' && (
            <p class="cv-entry-detail">
              <a href="/news/">Every talk, one row each →</a>
            </p>
          )}
          {section.entries.map((entry) => (
            <div class="cv-entry">
              <div class="cv-entry-head">
                <div>
                  <span class="cv-entry-title">
                    <MathText text={entry.title} />
                  </span>
                  {entry.where && (
                    <span class="cv-entry-where">
                      {' '}
                      · <MathText text={entry.where} />
                    </span>
                  )}
                </div>
                <span class="cv-entry-date">{entry.date}</span>
              </div>
              {entry.detail && (
                <p class="cv-entry-detail">
                  <MathText text={entry.detail} />
                </p>
              )}
            </div>
          ))}
        </div>
      ))}

      <div class="cv-section">
        <h2>Skills</h2>
        <ul class="skills-list">
          {skills.map((skill) => (
            <li class="skill">{skill}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
